# Copy to .env and fill in real values from the team / client.
#   cp .env.example .env

# Required at API startup (main.py). Use the real GCS bucket for uploads/STT.
# For boot-only local smoke tests you may use a placeholder name; GCS calls will fail without real GCP auth.
GCS_BUCKET_NAME=your-gcs-bucket-name

# Optional: path to service account JSON (local dev)
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account.json

# Optional: Vertex / Gemini (visit summary pipeline)
# GCP_PROJECT=your-gcp-project-id
# GEMINI_API_KEY=
# MODEL_NAME=gemini-2.5-flash-lite

# Optional: Cloud SQL PostgreSQL (when all are set, pending SQL migrations run on API startup)
# DB_HOST=
# DB_PORT=5432
# DB_NAME=
# DB_USER=
# DB_PASSWORD=

# Skip automatic migration application on FastAPI startup (unit tests or special deploys)
# SKIP_DB_MIGRATIONS=false

# Auth: verify Firebase ID tokens (should match mobile Firebase project)
# FIREBASE_PROJECT_ID=

# Optional: mirror FCM token to Firestore document patients/{firebase_uid} (merge)
# Requires Firestore API enabled and FIREBASE_SERVICE_ACCOUNT configured.
# FIRESTORE_FCM_SYNC=true

# Care team invite emails (Brevo transactional API). CARE_TEAM_INVITE_SIGNUP_URL is the
# app download / signup deep link; token is appended as ?token= or &token=.
# BREVO_SENDER_EMAIL must be a verified sender in Brevo.
# BREVO_API_KEY=
# BREVO_SENDER_EMAIL=
# BREVO_SENDER_NAME=RemiMinderAI
# CARE_TEAM_INVITE_SIGNUP_URL=https://example.com/install

# Optional: send caregiver alert emails via SES (requires SES_SENDER_EMAIL, AWS creds).
# In-app alerts are always written to caregiver_alerts when triggers fire.
# CAREGIVER_ALERT_EMAIL=true

# Internal cron (POST with header X-Internal-Secret: INTERNAL_CRON_SECRET):
#   /api/internal/caregiver-missed-reminder-alerts — overdue caregiver alerts
#   /api/internal/reminder-due-fcm — due-window FCM for patient + caregivers (e.g. every 1 min)
# INTERNAL_CRON_SECRET=generate-a-long-random-string

HOST=0.0.0.0
# If Docker (or another app) uses 8000, set PORT=8001 and match the mobile app URL.
PORT=8000
DEBUG=True
