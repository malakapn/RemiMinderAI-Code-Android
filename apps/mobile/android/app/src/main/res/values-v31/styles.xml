<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+ system splash: cream background, no centered app icon. -->
    <style name="LaunchTheme" parent="@android:style/Theme.NoTitleBar">
        <item name="android:windowBackground">@color/background</item>
        <item name="android:windowSplashScreenBackground">@color/background</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_icon_blank</item>
        <item name="android:windowSplashScreenIconBackgroundColor">@color/background</item>
    </style>
</resources>
