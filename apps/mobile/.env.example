# Copy to `apps/mobile/.env` before `flutter run` / `flutter build` (see ENV_SETUP.md, pubspec assets).
AUTH_PROVIDER=firebase
MOBILE_API_BASE_URL=http://localhost:8000
API_BASE_URL=http://localhost:8000
FLUTTER_ENV=development
# Firebase Web client ID (ends with .apps.googleusercontent.com). Either name works:
GOOGLE_WEB_CLIENT_ID=
# GOOGLE_CLIENT_ID=
# Billing is RevenueCat (Play Store / App Store). No Stripe checkout in the app.
