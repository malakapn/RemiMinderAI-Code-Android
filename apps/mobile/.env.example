# Copy to `apps/mobile/.env` before `flutter run` / `flutter build` (see pubspec.yaml assets).
AUTH_PROVIDER=firebase
MOBILE_API_BASE_URL=http://localhost:8000
API_BASE_URL=http://localhost:8000
FLUTTER_ENV=development
# Google Sign-In + Firebase Auth (Android): Web client ID so Google returns an id token.
# Firebase Console → Project settings → Your apps → Web app client id (ends with .apps.googleusercontent.com)
GOOGLE_WEB_CLIENT_ID=
# Optional Stripe / billing deep links (override defaults in code if set)
# BILLING_URL_SCHEME=com.remiminder.app.dev
# BILLING_SUCCESS_URL=
# BILLING_CANCEL_URL=
